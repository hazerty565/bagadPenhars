# Variables d'environnement — Bagad Penhars
# Copier ce fichier vers `.env` et renseigner les valeurs réelles.
# Ne jamais committer `.env` ni aucun secret.

# --- Base de données (Neon PostgreSQL) ---
DATABASE_URL=

# --- Better Auth ---
# Clé privée utilisée comme secret de signature Better Auth.
BETTER_AUTH_API_KEY=
BETTER_AUTH_URL=http://localhost:5173

# --- E-mail transactionnel (Resend) ---
RESEND_API_KEY=
# Adresse de réception des messages du formulaire de contact
CONTACT_EMAIL=
# Expéditeur vérifié chez Resend (domaine authentifié, différent de l'adresse de
# réception). Laisser vide pour retomber sur CONTACT_EMAIL.
CONTACT_FROM=

# --- Cloudflare Turnstile ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cloudflare R2 (identifiants S3, bindings R2_PUBLIC / R2_PRIVATE) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=
R2_BUCKET_PRIVATE=

# --- OneSignal ---
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
