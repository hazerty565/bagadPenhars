# Variables locales de développement — Bagad Penhars
# Copier ce fichier vers `.env` et renseigner les valeurs de Neon `test`.
# Pour Cloudflare Preview/Production, configurer les secrets dans chaque
# environnement Cloudflare et le binding Hyperdrive correspondant.
# Ce fichier est un modèle local; ne jamais committer `.env` ni aucun secret.

# --- Base de données (Neon PostgreSQL) ---
DATABASE_URL=

# --- Better Auth ---
# Secret de signature Better Auth; définir une valeur différente par environnement.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# --- E-mail transactionnel (Resend) ---
RESEND_API_KEY=
# Adresse de réception des messages du formulaire de contact
CONTACT_EMAIL=
# Expéditeur vérifié chez Resend (domaine authentifié, différent de l'adresse de
# réception). Laisser vide pour retomber sur CONTACT_EMAIL.
CONTACT_FROM=

# --- Cloudflare Turnstile ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cloudflare R2 (identifiants S3, bindings R2_PUBLIC / R2_PRIVATE) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=
R2_BUCKET_PRIVATE=

# --- OneSignal ---
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
