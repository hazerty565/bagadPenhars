# =============================================================================
# Bagad Penhars — Variables d'environnement
# Copier ce fichier vers .env (local) ou injecter dans Cloudflare Pages
# Aucun secret ne doit jamais être committé.
# =============================================================================

# --- Base de données Neon via Cloudflare Hyperdrive (pooling uniquement) ---
# Chaîne de connexion PostgreSQL fournie par Hyperdrive, spécifique à la branche
# Neon (test ou production).
DATABASE_URL="postgres://<user>:<password>@<hyperdrive-host>:5432/bagadpenhars?sslmode=require"

# --- Better Auth ---
# Clé secrète pour signer les jetons Better Auth (générer avec openssl rand -hex 32)
BETTER_AUTH_SECRET="<better-auth-secret>"
# URL publique de l'application (sans slash final)
BETTER_AUTH_URL="http://localhost:5173"

# --- Adresse e-mail de l'association (destinataire du formulaire de contact) ---
CONTACT_EMAIL="bagadpenhars@gmail.com"

# --- Cloudflare R2 ---
R2_ACCOUNT_ID="<cloudflare-account-id>"
R2_ACCESS_KEY_ID="<r2-access-key-id>"
R2_SECRET_ACCESS_KEY="<r2-secret-access-key>"
R2_BUCKET_PUBLIC="bagad-public"
R2_BUCKET_PRIVATE="bagad-private"

# --- Resend (emails) ---
RESEND_API_KEY="re_<resend-api-key>"

# --- Cloudflare Turnstile (anti-spam formulaire de contact) ---
TURNSTILE_SITE_KEY="0x<turnstile-site-key>"
TURNSTILE_SECRET_KEY="0x<turnstile-secret-key>"

# --- OneSignal (notifications push) ---
ONESIGNAL_APP_ID="<onesignal-app-id>"
ONESIGNAL_REST_API_KEY="<onesignal-rest-api-key>"
